server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 25m;
    add_header X-Content-Type-Options nosniff always;
    resolver 127.0.0.11 valid=10s ipv6=off;
    # API and files always come from the same database/storage on this server.
    set $backend_upstream http://backend-gateway:80;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # Every backend request, including authenticated downloads, stays on this origin.
    location ~ ^/(api|admin|static|media/pecas_360|media/pecas_3d)/ {
        proxy_pass $backend_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        # The public TLS endpoint is Funnel. Do not trust client-supplied headers.
        proxy_set_header X-Forwarded-Proto ${PUBLIC_SCHEME};
        proxy_connect_timeout 5s;
        proxy_read_timeout 360s;
        proxy_send_timeout 360s;
        # Preserve application errors (e.g. missing Ollama model); only replace
        # connection errors generated by this proxy.
        proxy_intercept_errors off;
        error_page 502 503 504 =503 @backend_unavailable;
    }

    location @backend_unavailable {
        default_type application/json;
        add_header Cache-Control no-store always;
        return 503 '{"detail":"O backend está indisponível. Tente novamente em alguns instantes."}';
    }

    location ^~ /media/user_uploads/ { return 404; }
    location /media/ { return 404; }
    location ~ /\. { return 404; }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
