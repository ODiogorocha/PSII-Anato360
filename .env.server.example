# Server overrides. Keep Django/MySQL credentials in .env on the SERVER.
# docker compose --env-file .env --env-file .env.server -f compose.server.yaml up -d --build
APP_PORT=80
# Replace with the PC Tailscale IPv4 from: tailscale ip -4
# If Tailscale runs in Ubuntu WSL, run that command inside Ubuntu and use its IP.
# This private Windows gateway is used only for Ollama/image processing.
# The API, MySQL, Redis and files always remain on the server.
# Use the Tailscale IP (100.x.y.z), without a trailing slash.
BACKEND_UPSTREAM=http://100.100.100.100:8081
# The existing Funnel endpoint terminates HTTPS.
PUBLIC_SCHEME=https

# Read timeout on Windows before trying local compute; connection timeout is 3s.
OLLAMA_PRIMARY_TIMEOUT=60
# Total Ollama request budget, shared between the two attempts.
OLLAMA_REQUEST_TIMEOUT=300
IMAGE_PROCESSOR_PRIMARY_TIMEOUT=120
# Maximum read wait for the local fallback (Celery processes in the background).
IMAGE_PROCESSOR_TIMEOUT=1800

DJANGO_ALLOWED_HOSTS=srv-01.tail881f91.ts.net,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://srv-01.tail881f91.ts.net
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=false
